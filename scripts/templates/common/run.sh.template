set -u

CURRENT_PATH=$(cd "$(dirname "$0")"; pwd)
PROJECT_ROOT=$(cd "${CURRENT_PATH}/.."; pwd)

# 可执行文件由 CMake 输出到 build/bin，脚本与工程 bin/ 同目录；优先 build/bin，
# 若用户手动把二进制拷到 bin/ 也可用。
if [ -d "${PROJECT_ROOT}/build/bin" ]; then
  BIN_DIR="${PROJECT_ROOT}/build/bin"
else
  BIN_DIR="${CURRENT_PATH}"
fi
LOG_DIR="${BIN_DIR}/log"

PROJECT_NAME=${PROJECT_NAME}
PROCS="${PROCS}"

mkdir -p "${LOG_DIR}"

conf_of() {
  case "$1" in
${CONF_CASES}
    *)
      echo "${PROJECT_ROOT}/conf/${PROJECT_NAME}.conf" ;;
  esac
}

start_one() {
  local exe="$1"
  local conf="$2"
  local bin_file="${BIN_DIR}/${exe}"
  if [ ! -x "${bin_file}" ]; then
    echo "[run] binary not found: ${bin_file}, build first: cmake --build build"
    return 1
  fi
  "${CURRENT_PATH}/shutdown.sh" "${exe}" >/dev/null 2>&1 || true
  (cd "${PROJECT_ROOT}" && nohup "${bin_file}" -i "${conf}" >> "${LOG_DIR}/${exe}.nohup_log" 2>&1 &)
  echo "[run] started ${exe}: ${bin_file} -i ${conf}"
}

start_all() {
  for exe in ${PROCS}; do
    start_one "${exe}" "$(conf_of "${exe}")"
    sleep 1
  done
}

case "${1:-all}" in
  all|start)
    start_all ;;
  *)
    start_one "$1" "$(conf_of "$1")" ;;
esac
